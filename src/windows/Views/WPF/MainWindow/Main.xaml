<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="14">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: the title and the working folder on the left, the add, the
         refresh, the settings, the sun and the close on the other side. -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="WSL Fleet" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBlock Name="TxtRoot" Foreground="{DynamicResource AppMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Name="BtnAdd" Grid.Column="1" Content="&#xF067;" FontFamily="{DynamicResource IconFace}"
                Margin="0,0,8,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Add"/>
        <Button Name="BtnRefresh" Grid.Column="2" Content="&#xF021;" FontFamily="{DynamicResource IconFace}"
                VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Refresh"/>
        <Button Name="BtnSettings" Grid.Column="3" Content="&#xF013;" FontFamily="{DynamicResource IconFace}"
                Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Settings"/>
        <Button Name="BtnTheme" Grid.Column="4" Content="&#xF185;" FontFamily="{DynamicResource IconFace}"
                Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Switch to light"/>
        <Button Name="BtnQuit" Grid.Column="5" Content="&#xF00D;" FontFamily="{DynamicResource IconFace}"
                Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Close"/>
    </Grid>

    <!-- The instances -->
    <ListView Name="LstInstances" Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppDividerBrush}" Foreground="{DynamicResource AppForegroundBrush}"
              AlternationCount="2" KeyboardNavigation.TabNavigation="Continue"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}"/>
                <GridViewColumn Header="Action" Width="Auto">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- An archived row carries its own two - restore
                                         and the trash; a live row the rest: a shell
                                         in a terminal of its own, the pack editor,
                                         the appearance, the copy, the archive, the
                                         Compact and the trash. The styles arrive by
                                         DynamicResource: this template loads after the
                                         window is parsed, and a StaticResource from
                                         here cannot see the dictionary merged in code
                                         (measured, cell template beside a local key).
                                         The line's own IsArchive decides which set
                                         stands (the style's trigger). -->
                                    <Button Name="BtnRowRestore" Content="&#xF2EA;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource ArchivedRowButton}"
                                            ToolTip="Restore"/>
                                    <Button Name="BtnRowDeleteArchive" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource ArchivedRowButton}"
                                            ToolTip="Delete"/>
                                    <Button Name="BtnRowOpen" Content="&#xF120;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Shell"/>
                                    <Button Name="BtnRowEdit" Content="&#xF304;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Edit"/>
                                    <Button Name="BtnRowAppearance" Content="&#xF53F;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Appearance"/>
                                    <Button Name="BtnRowDuplicate" Content="&#xF0C5;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Duplicate"/>
                                    <Button Name="BtnRowArchive" Content="&#xF187;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Archive"/>
                                    <Button Name="BtnRowCompact" Content="&#xF066;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Compact"/>
                                    <Button Name="BtnRowRemove" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}"
                                            Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Remove"/>
                                </StackPanel>
                                <ProgressBar Name="RowSpinner" IsIndeterminate="True" Height="4" Width="24"
                                             Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Foreground="{DynamicResource AppForegroundBrush}" Background="{DynamicResource AppInputBackgroundBrush}" BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>

    <!-- The progress bar (hidden until something runs) -->
    <ProgressBar Name="PrgWork" Grid.Row="2" Height="4" Margin="0,10,0,0"
                 IsIndeterminate="True" Visibility="Collapsed"
                 Foreground="{DynamicResource AppForegroundBrush}" Background="{DynamicResource AppInputBackgroundBrush}" BorderThickness="0"/>

    <!-- Status line: a read-only box, not a label - same look, but the
         text can be selected and copied (TextBlock never offers that). -->
    <TextBlock Name="TxtStatus" Grid.Row="3" Margin="0,8,0,0"
           Foreground="{DynamicResource AppNewsBrush}" Text="Ready."
           TextTrimming="CharacterEllipsis"
           MaxWidth="400"
           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
</Grid>
