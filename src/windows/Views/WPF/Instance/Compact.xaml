<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Name="TxtLead" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock Margin="0,10,0,0" Text="WARNING: THE INSTANCE WILL BE STOPPED." FontWeight="Bold" Foreground="{DynamicResource AppWarningBrush}"/>
    <TextBlock Margin="0,10,0,10" TextWrapping="Wrap">Make sure nothing is running inside.</TextBlock>
    <CheckBox Name="ChkArchive" TabIndex="0" Margin="0,12,0,0" Content="Archive it first"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnGateCancel" TabIndex="1" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Style="{DynamicResource BtnCancel}"/>
        <Button Name="BtnGateCompact" TabIndex="2" Content="COMPACT" IsDefault="True"
                Style="{DynamicResource BtnApply}"/>
    </StackPanel>
</StackPanel>
