<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Text="WARNING: PERMANENT DELETION" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}"/>
    <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
    <TextBlock Margin="0,14,0,10" TextWrapping="Wrap" Text="To confirm DELETION, type the name of the archive:"/>
    
    <TextBox Name="TxtName" Text="{Binding Typed, Mode=OneWay}" TabIndex="0" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnArchiveCancel" TabIndex="1" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnArchiveDelete" TabIndex="2" Content="DELETE" IsDefault="True" Command="{Binding ConfirmCommand}"
                Background="{DynamicResource AppDeleteBrush}" Foreground="{DynamicResource AppDeleteInkBrush}" BorderBrush="{DynamicResource AppDeleteBorderBrush}"/>
    </StackPanel>
</StackPanel>
