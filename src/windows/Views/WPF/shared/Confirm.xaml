<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Name="TxtLead" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock Name="TxtQuestion" Margin="0,10,0,10" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnConfirmCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Style="{DynamicResource BtnCancel}"/>
        <Button Name="BtnConfirmOk" Content="CONFIRM" IsDefault="True" Command="{Binding ConfirmCommand}"
                Style="{DynamicResource BtnDelete}"/>
    </StackPanel>
</StackPanel>
