<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Name="TxtLead" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock Name="TxtCarried" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
    <TextBlock Name="TxtOffered" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
    <TextBlock Name="TxtRemovable" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnPacksClose" Content="CLOSE" IsDefault="True"
                Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
    </StackPanel>
</StackPanel>
