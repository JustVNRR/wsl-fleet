<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Name="TxtLead" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock Name="TxtNothing" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}" Visibility="Collapsed"/>
    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
        <StackPanel Name="PnlPacks"/>
    </ScrollViewer>
    <TextBlock Name="TxtWillAdd" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Visibility="Collapsed"/>
    <TextBlock Name="TxtWillRemove" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnPacksCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnPacksApply" Content="APPLY" IsDefault="True"
                Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
    </StackPanel>
</StackPanel>
