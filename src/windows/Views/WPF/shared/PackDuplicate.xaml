<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Name="TxtLead" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock Margin="0,10,0,0" Text="Name:"/>
    <TextBox Name="TxtDupName" Margin="0,4,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
    <TextBlock Margin="0,10,0,0" Text="Description:"/>
    <TextBox Name="TxtDupDescription" Margin="0,4,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
    <TextBlock Name="TxtDupError" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnDupCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Style="{DynamicResource BtnCancel}"/>
        <Button Name="BtnDupOk" Content="APPLY" IsDefault="True"
                Style="{DynamicResource BtnApply}"/>
    </StackPanel>
</StackPanel>
