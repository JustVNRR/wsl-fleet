<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
        <ItemsControl ItemsSource="{Binding PackRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Margin="0,3,0,3" IsChecked="{Binding Checked}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Label}"/>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    <TextBlock Text="{Binding WillAdd}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
    <TextBlock Text="{Binding WillRemove}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnPacksCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnPacksApply" Content="APPLY" IsDefault="True" Command="{Binding ApplyCommand}"
                Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
    </StackPanel>
</StackPanel>
