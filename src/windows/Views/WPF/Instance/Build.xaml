<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,18,18,4">
            <TextBlock Text="NEW WSL DISTRIBUTION" FontWeight="SemiBold"/>
            <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
            <TextBlock Margin="0,10,0,0" Text="Instance name:"/>
            
            <TextBox Name="TxtName" Text="{Binding Name, Mode=OneWay}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
            <TextBlock Text="{Binding NameError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
            <TextBlock Name="LblUser" Margin="0,12,0,0" Text="User name:" IsEnabled="{Binding RunOnboarding}"/>
            <TextBox Name="TxtUser" Text="{Binding User, Mode=OneWay}" IsEnabled="{Binding RunOnboarding}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
            <TextBlock Text="{Binding UserError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
            <TextBlock Margin="0,12,0,0" Text="Build from:"/>
            <ComboBox Name="CmbRoad" SelectedIndex="{Binding RoadIndex, Mode=OneWay}" Margin="0,6,0,0">
                <ComboBoxItem Content="Dockerfile"/>
                <ComboBoxItem Content="Docker image"/>
                <ComboBoxItem Content="Docker registry"/>
                <ComboBoxItem Content="Recipe"/>
            </ComboBox>
            <StackPanel Name="BoxDockerfile">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDockerfile}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,10,0,0" Text="Dockerfile:"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="CmbDockerfile" ItemsSource="{Binding DockerfileNames}" SelectedIndex="{Binding DockerfileIndex, Mode=OneWay}" Grid.Column="0"/>
                    <Button Name="BtnDockerfileUpload" Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload a Dockerfile..."/>
                    
                    <Button Name="BtnDockerfileDownload" Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadDockerfile}" ToolTip="Save the selected Dockerfile..."/>
                    <Button Name="BtnDockerfileEdit" Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the selected Dockerfile in the code editor"/>
                    <Button Name="BtnDockerfileDelete" Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashDockerfile}" ToolTip="Delete the selected uploaded file"/>
                </Grid>
                <CheckBox Name="ChkSaveImage" IsChecked="{Binding SaveImage, Mode=OneWay}" Margin="0,10,0,0" Content="Save image locally" Foreground="{DynamicResource AppForegroundBrush}"/>
            </StackPanel>
            <StackPanel Name="BoxDockerImage">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowImage}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,10,0,0" Text="Docker image:"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="CmbDockerImage" ItemsSource="{Binding ImageNames}" SelectedIndex="{Binding ImageIndex, Mode=OneWay}" Grid.Column="0"/>
                    <Button Name="BtnDockerImageUpload" Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload an image (.tar)..."/>
                    <Button Name="BtnDockerImageDownload" Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadImage}" ToolTip="Save the selected Docker image..."/>
                    <Button Name="BtnDockerImageDelete" Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashImage}" ToolTip="Delete the selected uploaded file"/>
                </Grid>
                <TextBlock Text="{Binding ImageError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
            </StackPanel>
            <StackPanel Name="BoxRegistry">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRegistry}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,10,0,0" Text="Registry image:"/>
                <TextBox Name="TxtRegistry" Text="{Binding RegistryRef, Mode=OneWay}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
                <TextBlock Text="{Binding RegistryError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
            </StackPanel>
            <StackPanel Name="BoxRecipe">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRecipe}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Margin="0,10,0,0" Text="Recipe:"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="CmbRecipe" ItemsSource="{Binding RecipeNames}" SelectedIndex="{Binding RecipeIndex, Mode=OneWay}" Grid.Column="0"/>
                    <Button Name="BtnRecipeNew" Grid.Column="1" Content="&#xF067;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Create a recipe..."/>
                    <Button Name="BtnRecipeEdit" Grid.Column="2" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Open the recipe's folder in the code editor"/>
                    <Button Name="BtnRecipeDelete" Grid.Column="3" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashRecipe}" ToolTip="Delete the selected recipe"/>
                </Grid>
                <TextBlock Text="{Binding RecipeError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
                <CheckBox Name="ChkSaveImageRecipe" IsChecked="{Binding SaveImage, Mode=OneWay}" Margin="0,10,0,0" Content="Save image locally" Foreground="{DynamicResource AppForegroundBrush}"/>
            </StackPanel>
            <CheckBox Name="ChkRegisterDocker" IsChecked="{Binding RegisterDocker, Mode=OneWay}" Margin="0,12,0,0" Content="Add Docker Desktop support (will be restarted)" Foreground="{DynamicResource AppForegroundBrush}"/>
            <CheckBox Name="ChkRunOnboarding" IsChecked="{Binding RunOnboarding, Mode=OneWay}" Margin="0,12,0,0" Content="Run onboarding shell" Foreground="{DynamicResource AppForegroundBrush}"/>
            <StackPanel Name="BoxOnboarding" IsEnabled="{Binding RunOnboarding}">
                <TextBlock Margin="0,10,0,0" Text="Onboarding:"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="CmbOnboarding" ItemsSource="{Binding OnboardingNames}" SelectedIndex="{Binding OnboardingIndex, Mode=OneWay}" Grid.Column="0"/>
                    <Button Name="BtnOnboardingUpload" Grid.Column="1" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload onboarding shell..."/>
                    <Button Name="BtnOnboardingDownload" Grid.Column="2" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanDownloadOnboarding}" ToolTip="Save the selected onboarding shell..."/>
                    <Button Name="BtnOnboardingEdit" Grid.Column="3" Content="&#xF040;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the selected onboarding shell in the code editor"/>
                    <Button Name="BtnOnboardingDelete" Grid.Column="4" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" IsEnabled="{Binding CanTrashOnboarding}" ToolTip="Delete the selected uploaded file"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,10,18,16">
        <Button Name="BtnAddCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnAddCreate" Content="CREATE" IsDefault="True" Command="{Binding CreateCommand}"
                Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
    </StackPanel>
</Grid>
