<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Text="Root folder" FontWeight="SemiBold"/>
    <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding Root}" IsEnabled="False" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
        <Button Name="BtnGuiRootEdit" Grid.Column="1" Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Edit the working folder"/>
    </Grid>
    <TextBlock Text="Appearance" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,0"/>
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Font"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <ComboBox Name="LstGuiFonts" ItemsSource="{Binding Fonts}" DisplayMemberPath="Label" SelectedIndex="{Binding FontIndex}"/>
            <Button Name="BtnGuiFontUpload" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload a font file..."/>
        </StackPanel>
        <ComboBox Name="LstGuiSizes" ItemsSource="{Binding Sizes}" SelectedIndex="{Binding SizeIndex}" Grid.Row="1" Grid.Column="1" Margin="16,6,0,0"/>
    </Grid>
    <TextBlock Margin="0,10,0,0" Text="Theme"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <ComboBox Name="LstGuiColours" ItemsSource="{Binding Colours}" DisplayMemberPath="Label" SelectedIndex="{Binding ColourIndex}"/>
        <Button Name="BtnGuiThemeEdit" Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Open the selected theme in the default editor">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanTheme}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
        <Button Name="BtnGuiThemeUpload" Content="&#xF093;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Upload a theme file..."/>
        <Button Name="BtnGuiThemeDownload" Content="&#xF019;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Save the selected theme..."/>
        <Button Name="BtnGuiThemeDelete" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Delete the selected theme">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanTheme}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
    </StackPanel>
    <TextBlock Text="{Binding ThemeError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
    <TextBlock Margin="0,12,0,0" Text="Packs Catalog" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <ComboBox Name="LstGuiPacks" ItemsSource="{Binding Packs}" DisplayMemberPath="Label" SelectedIndex="{Binding PackIndex}"/>
        <Button Name="BtnGuiPackEdit" Content="&#xF044;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Open the selected pack's folder">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanPack}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
        <Button Name="BtnGuiPackDuplicate" Content="&#xF0C5;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Duplicate the selected pack under a new name">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanPack}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
        <Button Name="BtnGuiPackDelete" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}" Margin="8,0,0,0" ToolTip="Delete the selected pack">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanPack}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
    </StackPanel>
    <TextBlock Text="{Binding CatalogueError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnGuiClose" Content="CLOSE" IsDefault="True" IsCancel="True"
                Style="{DynamicResource BtnApply}"/>
    </StackPanel>
</StackPanel>
