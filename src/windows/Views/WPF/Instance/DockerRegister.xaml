<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
    <!-- La case : lien à sens unique — la vue relaie (voir le .xaml.ps1). -->
    <CheckBox Name="ChkRestart" IsChecked="{Binding Restart, Mode=OneWay}" Margin="0,14,0,0" Content="Restart Docker Desktop to apply now." Foreground="{DynamicResource AppForegroundBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnDockerCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Style="{DynamicResource BtnCancel}"/>
        <Button Name="BtnDockerConfirm" Content="APPLY" IsDefault="True" Command="{Binding ConfirmCommand}"
                Style="{DynamicResource BtnApply}"/>
    </StackPanel>
</StackPanel>
