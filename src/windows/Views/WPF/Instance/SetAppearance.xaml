<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="18">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- The body scrolls; the buttons stay pinned under it - a larger
         face or a smaller screen must never put APPLY out of reach
         (measured: at 19 pt they fell below the screen's edge). -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Column="0">
    <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}"
               Text="This instance has no Terminal profile of ours - nothing changed here would show.">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding NoFragment}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>
    <TextBlock Margin="0,12,0,0" Text="Icon text:"/>
    <!-- Les saisies : liens à sens unique — la vue relaie les écritures
         (voir le .xaml.ps1). -->
    <TextBox Name="TxtIconText" Text="{Binding IconText, Mode=OneWay}" Margin="0,6,0,0" HorizontalAlignment="Left"
             Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
    <TextBlock Text="{Binding IconError}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
    </StackPanel>
    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="14,0,0,0" Width="64" Height="64">
        <!-- La tuile, montree en direct : le degrade de la couleur choisie et
             les lettres dessus ; l'image choisie prend le siege par-dessus
             (voir le .xaml.ps1). Taille fixe : l'apercu ne saute plus d'une
             instance a l'autre. -->
        <!-- La tuile porte la marge de make-icon (2,3 %) : 60 dans la boite
             de 64 — l'icone (son png a la meme marge) et le dessin
             s'alignent. -->
        <Border Name="BrdTile" CornerRadius="13" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#333333"/>
        <!-- Les lettres : la recette de make-icon (police de sa liste, encre a
             74 % de la tuile), posee par le dessin — voir le .xaml.ps1. -->
        <TextBlock Name="TxtTile" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34"/>
        <Image Name="ImgIconPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
    <TextBlock Margin="0,10,0,0" Text="Icon color:"/>
    <ComboBox Name="LstPairs" ItemsSource="{Binding PairLabels}" SelectedIndex="{Binding PairIndex, Mode=OneWay}" Margin="0,6,0,0"/>
    <TextBlock Margin="0,10,0,0" Text="Icon file:"/>
    <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding ImagePath}" Foreground="{DynamicResource AppMutedBrush}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        <Button Name="BtnImage" Grid.Column="1" Content="Upload"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
    </Grid>
    <TextBlock Margin="0,14,0,0" Text="Font:"/>
    <ComboBox Name="LstFonts" ItemsSource="{Binding FontLabels}" SelectedIndex="{Binding FontIndex, Mode=OneWay}" Margin="0,6,0,0"/>
    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AppMutedBrush}" Text="Get more Nerd Fonts at https://www.nerdfonts.com"/>
    <TextBlock Margin="0,14,0,0" Text="Colour scheme:"/>
    <ComboBox Name="LstSchemes" ItemsSource="{Binding SchemeLabels}" SelectedIndex="{Binding SchemeIndex, Mode=OneWay}" Margin="0,6,0,0"/>
    <TextBlock Margin="0,14,0,0" Text="Preview:"/>
    <Border Name="BrdPreview" Margin="0,6,0,0" Padding="8,6" CornerRadius="3"
            Background="#0C0C0C" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="1">
        <StackPanel>
            <!-- A real session, colours and all: the prompt this house's
                 zsh draws (zsh/prompts/starship.toml) - directory in bold
                 yellow, branch in bold purple behind its glyph, character
                 in bold green - over two eza lines, the listing these
                 instances really show (permissions green for folders,
                 user yellow, dates magenta, folders blue with their
                 icons). Each run is tagged with the palette slot it takes
                 its colour from - the named colours the tools use ARE the
                 terminal palette - and the form repaints them with the
                 chosen scheme's own. -->
            <TextBlock Name="TxtPreview1" FontFamily="Consolas" Foreground="{DynamicResource AppForegroundBrush}">
                <Run Tag="c3" Text="[~/projects]" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock Name="TxtPreview2" FontFamily="Consolas" Foreground="{DynamicResource AppForegroundBrush}">
                <Run Tag="c5" Text="&#xF126; main " FontWeight="Bold"/>
                <Run Tag="c2" Text="&#x276F; " FontWeight="Bold"/>
                <Run Tag="fg" Text="ls"/>
            </TextBlock>
            <TextBlock Name="TxtPreview3" FontFamily="Consolas" Foreground="{DynamicResource AppForegroundBrush}">
                <Run Tag="c2" Text="drwxr-xr-x"/>
                <Run Tag="fg" Text="  -  "/>
                <Run Tag="c3" Text="underfit"/>
                <Run Tag="fg" Text="  "/>
                <Run Tag="c4" Text="2 Oct 18:52"/>
                <Run Tag="fg" Text="  "/>
                <Run Tag="c4" Text="&#xF07B; .config"/>
            </TextBlock>
            <TextBlock Name="TxtPreview4" FontFamily="Consolas" Foreground="{DynamicResource AppForegroundBrush}">
                <Run Tag="fg" Text="-rw-r--r-- "/>
                <Run Tag="c2" Text="165 "/>
                <Run Tag="c3" Text="underfit"/>
                <Run Tag="fg" Text="  "/>
                <Run Tag="c4" Text="2 Oct 18:52"/>
                <Run Tag="fg" Text="  &#xF15B; .wget-hsts"/>
            </TextBlock>
            <TextBlock Name="TxtPreview5" FontFamily="Consolas" Foreground="{DynamicResource AppForegroundBrush}">
                <Run Tag="c3" Text="[~/projects]" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock Name="TxtPreview6" FontFamily="Consolas" Foreground="{DynamicResource AppForegroundBrush}">
                <Run Tag="c5" Text="&#xF126; main " FontWeight="Bold"/>
                <Run Tag="c2" Text="&#x276F; " FontWeight="Bold"/>
                <Run Tag="fg" Text="_"/>
            </TextBlock>
            <StackPanel Name="PnlPalette" Orientation="Horizontal" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
    </StackPanel>
    </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnLookCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnLookApply" Content="APPLY" IsDefault="True" Command="{Binding ApplyCommand}"
                Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
    </StackPanel>
</Grid>
