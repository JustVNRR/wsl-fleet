<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Text="{Binding Lead}" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Margin="0,8,0,0"/>
    <TextBlock Name="TxtRunning" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}"
               Text="The instance will be stopped before it is copied. Save your work before proceeding."/>
    <TextBlock Margin="0,14,0,10" Text="Name of the copy:"/>
    
    <TextBox Name="TxtName" Text="{Binding Name, Mode=OneWay}" Margin="0,6,0,0" Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" Padding="4"/>
    <TextBlock Name="GuiNameError" Text="{Binding NameError}" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppDangerBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnDupCancel" Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnDupGo" Content="DUPLICATE" IsDefault="True" Command="{Binding ConfirmCommand}"
                Background="{DynamicResource AppForegroundBrush}" Foreground="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppForegroundBrush}"/>
    </StackPanel>
</StackPanel>
