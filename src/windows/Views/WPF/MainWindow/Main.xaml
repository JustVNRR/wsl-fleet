<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="14">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    
    <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="WSL Fleet" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBlock Text="{Binding Root, StringFormat='Root: {0}'}" Foreground="{DynamicResource AppMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Name="BtnAdd" Command="{Binding AddCommand}" Grid.Column="1" Content="&#xF067;" FontFamily="{DynamicResource IconFace}"
                Margin="0,0,8,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Add"/>
        <Button Name="BtnRefresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding Free}" Grid.Column="2" Content="&#xF021;" FontFamily="{DynamicResource IconFace}"
                VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Refresh"/>
        <Button Name="BtnSettings" Command="{Binding SettingsCommand}" Grid.Column="3" Content="&#xF013;" FontFamily="{DynamicResource IconFace}"
                Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Settings"/>
        <Button Name="BtnTheme" Command="{Binding ThemeCommand}" Grid.Column="4" Content="&#xF185;" FontFamily="{DynamicResource IconFace}"
                Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Switch to light"/>
        <Button Name="BtnQuit" Grid.Column="5" Content="&#xF00D;" FontFamily="{DynamicResource IconFace}"
                Margin="8,0,0,0" VerticalAlignment="Top"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                ToolTip="Close"/>
    </Grid>

    
    <ListView Name="LstInstances" ItemsSource="{Binding Rows}" IsEnabled="{Binding Free}" Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppDividerBrush}" Foreground="{DynamicResource AppForegroundBrush}"
              AlternationCount="2" KeyboardNavigation.TabNavigation="Continue"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}"/>
                <GridViewColumn Header="Action" Width="Auto">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    
                                    <Button Name="BtnRowRestore" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF2EA;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource ArchivedRowButton}"
                                            ToolTip="Restore"/>
                                    <Button Name="BtnRowDeleteArchive" Command="{Binding DataContext.DeleteArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource ArchivedRowButton}"
                                            ToolTip="Delete"/>
                                    <Button Name="BtnRowOpen" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF120;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Shell"/>
                                    <Button Name="BtnRowRestart" Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF01E;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Restart"/>
                                    <Button Name="BtnRowEdit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF304;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Edit"/>
                                    <Button Name="BtnRowAppearance" Command="{Binding DataContext.AppearanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF53F;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Appearance"/>
                                    <Button Name="BtnRowDuplicate" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF0C5;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Duplicate"/>
                                    <Button Name="BtnRowArchive" Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF187;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Archive"/>
                                    <Button Name="BtnRowCompact" Command="{Binding DataContext.CompactCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF066;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Compact"/>
                                    <Button Name="BtnRowDocker" Command="{Binding DataContext.DockerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF1B2;" FontFamily="{DynamicResource IconFace}"
                                            Margin="0,0,4,0" Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Docker Desktop"/>
                                    <Button Name="BtnRowRemove" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xF1F8;" FontFamily="{DynamicResource IconFace}"
                                            Background="Transparent"
                                            Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="Transparent"
                                            Style="{DynamicResource LiveRowButton}"
                                            ToolTip="Remove"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>

    
    <ProgressBar Grid.Row="2" Height="4" Margin="0,10,0,0"
                 IsIndeterminate="True"
                 Foreground="{DynamicResource AppForegroundBrush}" Background="{DynamicResource AppInputBackgroundBrush}" BorderThickness="0">
        <ProgressBar.Style>
            <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Busy}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ProgressBar.Style>
    </ProgressBar>
</Grid>
