<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Name="TxtLead" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <ListBox Name="LstPacks" MaxHeight="420" Margin="0,8,0,0"
             Background="{DynamicResource AppInputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
    <TextBlock Name="TxtQuestion" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppWarningBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnPackCancel" Content="Cancel" Width="80" Height="28" Margin="0,0,8,0" IsCancel="True"
                Background="{DynamicResource AppFaceBrush}" Foreground="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"/>
        <Button Name="BtnPackRemove" Content="REMOVE" Width="90" Height="28" IsDefault="True"
                Background="{DynamicResource AppDeleteBrush}" Foreground="{DynamicResource AppDeleteInkBrush}" BorderBrush="{DynamicResource AppDeleteBorderBrush}"/>
    </StackPanel>
</StackPanel>
