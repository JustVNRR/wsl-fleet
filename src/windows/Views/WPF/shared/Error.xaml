<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="18">
    <TextBlock Text="{Binding Lead}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AppDangerBrush}"/>
    <TextBlock Text="{Binding Stamp}" Margin="0,10,0,0" Foreground="{DynamicResource AppMutedBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="BtnErrorOk" Content="OK" IsDefault="True" IsCancel="True"
                Style="{DynamicResource BtnApply}"/>
    </StackPanel>
</StackPanel>
